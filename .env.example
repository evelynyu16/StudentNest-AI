# Copy to .env.local and fill in. Never commit real keys.

# --- Browser (exposed to the client, safe to be public) ---
# Supabase project settings -> API Keys (the publishable key works as the anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Google Maps JavaScript API key, restricted to your site's HTTP referrers
VITE_GOOGLE_MAPS_KEY=
# Optional: Map ID from Google Cloud console (needed for advanced markers)
VITE_GOOGLE_MAP_ID=
# Show "Continue with Google" (turn on the Google provider in Supabase first)
VITE_ENABLE_GOOGLE_SIGNIN=false

# --- Server only (used by /api functions, never sent to the browser) ---
# OpenAI platform -> API keys (sk-proj-...)
OPENAI_API_KEY=
# Optional: which GPT model to use (default gpt-5.4-mini)
OPENAI_MODEL=
# Google key with Geocoding API + Routes API enabled (server key, IP-restricted)
GOOGLE_MAPS_SERVER_KEY=
# Same Supabase project, used to check the signed-in user on /api calls
SUPABASE_URL=
SUPABASE_ANON_KEY=
